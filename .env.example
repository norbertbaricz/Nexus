# Local development: run npm start without copying this file.
# Copy to .env when you want to change defaults. Never commit the real .env.
PORT=3000
HOST=127.0.0.1

# Full HTTPS origin of a deployed Node.js instance.
# Leave empty on localhost. Set this on public deployments.
PUBLIC_ORIGIN=
TRUST_PROXY=false
SECURE_COOKIES=false
REGISTRATION_OPEN=true

# Optional live GIF search. Create a web API key at https://developers.giphy.com/.
# This key is returned to signed-in browsers because GIPHY requires client requests.
# Restrict it to your domains and request production access before a public launch.
GIPHY_API_KEY=

# Optional signing secret; leave blank to generate a random one on every start.
# Set a private random secret if request proofs should survive a server restart.
CSRF_SECRET=

# Relative paths resolve from the project working directory.
DATABASE_PATH=./data/nexus.sqlite
UPLOAD_PATH=./data/uploads

# STUN is sufficient on some networks. Add your own TURN relay for broader reach.
# This JSON is returned only to authenticated clients; prefer short-lived TURN credentials.
ICE_SERVERS='[{"urls":"stun:stun.cloudflare.com:3478"}]'

# Optional real TURN relay for calls across different/restrictive networks.
# Use endpoints and credentials issued by your actual relay provider.
# Comma-separated turn:/turns: URLs; leave blank for local/STUN-only development.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Preferred for a self-hosted coturn relay using TURN REST authentication.
# Match this private value with coturn's static-auth-secret. It is never sent to browsers.
# Authenticated clients receive credentials that expire after one hour.
TURN_SHARED_SECRET=
# Enable only to diagnose your configured relay; a relay must actually be running.
RTC_RELAY_ONLY=false

# Existing account with username @maxultimat3: leave both values empty.
# Its permanent ID is linked once when the upgraded server starts.
# Other existing username: copy Settings > Account > Account ID here before
# the first binding. A saved creator binding is never silently overwritten.
CREATOR_USER_ID=
# Fresh installation only: generate a private random token, set it here, then
# enter it in Create account when registering the reserved MaxUltimat3 username.
# Clear the token after successful registration. Never use an account password.
# Step-by-step instructions: docs/CREATOR_SETUP.md
CREATOR_CLAIM_TOKEN=

# Early member can only be earned during the launch window. Existing awards stay.
# The first account anchors the window; upgrades use the oldest account.
# These values are recorded once. Set them before the first start of this upgrade.
EARLY_MEMBER_WINDOW_DAYS=90
# Optional exact end, e.g. 2027-01-01T00:00:00Z. Leave blank for the day window.
EARLY_MEMBER_ENDS_AT=

# Personal community import is explicit: npm run setup:community -- setup/community.json
# Stop Nexus before importing. The normal server does not load community content.

# Optional recovery email. Recovery codes work without SMTP.
# PUBLIC_ORIGIN above must be the real HTTPS website origin used in emailed links.
# Use a provider-approved sender and private SMTP credentials. Never commit them.
MAIL_HOST=
MAIL_PORT=587
# Use true for implicit TLS on port 465; port 587 always requires STARTTLS.
MAIL_SECURE=false
MAIL_FROM=
MAIL_USER=
MAIL_PASSWORD=

# Host-assisted account recovery: recover-account.bat / bash recover-account.sh
# Independently verify ownership first. See docs/ACCOUNT_RECOVERY.md.
